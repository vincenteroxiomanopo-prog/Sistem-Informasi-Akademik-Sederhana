@page "/mahasiswa"
@inject MahasiswaService Service
@inject NotificationService Notifier

<PageTitle>Daftar Mahasiswa</PageTitle>

<h1>Daftar Mahasiswa</h1>
<a class="btn btn-primary mb-3" href="mahasiswa/tambah">Tambah Mahasiswa</a>

<form class="row g-2 mb-3" @onsubmit="SearchAsync">
    <div class="col-sm-6 col-md-5">
        <input class="form-control" placeholder="Cari NIM atau nama..."
               @bind="searchText" @bind:event="oninput" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary" disabled="@isLoading">Cari</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="ResetAsync" disabled="@isLoading">Reset</button>
    </div>
</form>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 my-3">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Memuat data mahasiswa...</span>
    </div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">
        <p class="mb-2">@errorMessage</p>
        <button class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Coba lagi</button>
    </div>
}
else if (mahasiswaList.Count == 0)
{
    <div class="alert alert-info">
        @(string.IsNullOrWhiteSpace(activeSearch)
            ? "Belum ada data mahasiswa."
            : $"Tidak ada mahasiswa yang cocok dengan '{activeSearch}'.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>No</th>
                    <th role="button" @onclick='() => SortAsync("nim")'>NIM @Arrow("nim")</th>
                    <th role="button" @onclick='() => SortAsync("nama")'>Nama Mahasiswa @Arrow("nama")</th>
                    <th>Email</th>
                    <th role="button" @onclick='() => SortAsync("angkatan")'>Angkatan @Arrow("angkatan")</th>
                    <th>Dosen Wali</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < mahasiswaList.Count; i++)
                {
                    var mahasiswa = mahasiswaList[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@mahasiswa.Nim</td>
                        <td>@mahasiswa.NamaMahasiswa</td>
                        <td>@mahasiswa.Email</td>
                        <td>@mahasiswa.Angkatan</td>
                        <td>@mahasiswa.NamaDosenWali</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary me-1" href="mahasiswa/edit/@mahasiswa.MahasiswaId">Edit</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(mahasiswa)">Hapus</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (mahasiswaToDelete is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Konfirmasi Hapus</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Hapus mahasiswa <strong>@mahasiswaToDelete.NamaMahasiswa</strong> (NIM @mahasiswaToDelete.Nim)?
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete" disabled="@isDeleting">Batal</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@isDeleting">
                        @(isDeleting ? "Menghapus..." : "Ya, hapus")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MahasiswaModel> mahasiswaList = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string? searchText;    
    private string? activeSearch;  
    private string? urut;
    private bool desc;
    private MahasiswaModel? mahasiswaToDelete;
    private bool isDeleting;
    
    private async Task SortAsync(string kolom)
    {
        // Klik kolom yang sama = balik arah. Kolom baru = mulai dari naik.
        desc = urut == kolom && !desc;
        urut = kolom;
        await LoadAsync();
    }
    private string Arrow(string kolom) =>
    urut != kolom ? "" : desc ? " ▼" : " ▲";

    private async Task SearchAsync()
    {
        activeSearch = searchText?.Trim();
        await LoadAsync();
    }

    private async Task ResetAsync()
    {
        searchText = null;
        activeSearch = null;
        urut = null;
        desc = false;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        var result = await Service.GetAllAsync(activeSearch, urut, desc);

        if (result.IsSuccess)
        {
            mahasiswaList = result.Data ?? new();
        }
        else
        {
            errorMessage = result.Message;
        }

        isLoading = false;
    }

    private void AskDelete(MahasiswaModel mahasiswa)
    {
        mahasiswaToDelete = mahasiswa;
    }

    private void CancelDelete()
    {
        mahasiswaToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (mahasiswaToDelete is null)
        {
            return;
        }

        isDeleting = true;

        var result = await Service.DeleteAsync(mahasiswaToDelete.MahasiswaId);

        if (result.IsSuccess)
        {
            Notifier.ShowSuccess(result.Message);
        }
        else
        {
            Notifier.ShowError(result.Message);
        }

        mahasiswaToDelete = null;
        isDeleting = false;

        if (result.IsSuccess)
        {
            await LoadAsync();
        }
    }
}