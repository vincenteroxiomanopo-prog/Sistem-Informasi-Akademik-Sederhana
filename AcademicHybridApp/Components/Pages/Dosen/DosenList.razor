@page "/dosen"
@inject DosenService Service
@inject NotificationService Notifier

<PageTitle>Daftar Dosen</PageTitle>

<h1>Daftar Dosen</h1>

<a class="btn btn-primary mb-3" href="dosen/tambah">Tambah Dosen</a>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 my-3">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Memuat data dosen...</span>
    </div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">
        <p class="mb-2">@errorMessage</p>
        <button class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Coba lagi</button>
    </div>
}
else if (dosenList.Count == 0)
{
    <div class="alert alert-info">Belum ada data dosen.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>No</th>
                <th>NIDN</th>
                <th>Nama Dosen</th>
                <th>Email</th>
                <th>Prodi</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < dosenList.Count; i++)
            {
                var dosen = dosenList[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@dosen.Nidn</td>
                    <td>@dosen.NamaDosen</td>
                    <td>@dosen.Email</td>
                    <td>@dosen.Prodi</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="dosen/edit/@dosen.DosenId">Edit</a>
                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => AskDelete(dosen)">Hapus</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (dosenToDelete is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Konfirmasi Hapus</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Hapus dosen <strong>@dosenToDelete.NamaDosen</strong> (NIDN @dosenToDelete.Nidn)?
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete" disabled="@isDeleting">Batal</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@isDeleting">
                        @(isDeleting ? "Menghapus..." : "Ya, hapus")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DosenModel> dosenList = new();
    private bool isLoading = true;
    private string? errorMessage;

    private DosenModel? dosenToDelete;
    private bool isDeleting;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        var result = await Service.GetAllAsync();

        if (result.IsSuccess)
        {
            dosenList = result.Data ?? new();
        }
        else
        {
            errorMessage = result.Message;
        }

        isLoading = false;
    }

    private void AskDelete(DosenModel dosen)
    {
        dosenToDelete = dosen;
    }

    private void CancelDelete()
    {
        dosenToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (dosenToDelete is null)
        {
            return;
        }

        isDeleting = true;

        var result = await Service.DeleteAsync(dosenToDelete.DosenId);

        if (result.IsSuccess)
        {
            Notifier.ShowSuccess(result.Message);
        }
        else
        {
            Notifier.ShowError(result.Message);
        }

        dosenToDelete = null;
        isDeleting = false;

        if (result.IsSuccess)
        {
            await LoadAsync();
        }
    }
}